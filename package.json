{
  "name": "opencode-plugin-template",
  "version": "0.1.0",
  "description": "Template for building organization-specific OpenCode plugins. Bundles a cross-platform sideloader so plugins install via pnpm/npm/bun on macOS and Windows.",
  "module": "dist/v1/index.js",
  "type": "module",
  "main": "dist/v1/index.js",
  "exports": {
    ".": "./dist/v1/index.js",
    "./v1": "./dist/v1/index.js",
    "./v2": "./dist/v2/index.js",
    "./injector": "./dist/injector.js"
  },
  "scripts": {
    "build": "bun build v1/index.ts v2/index.ts injector.ts --outdir dist --target node --format esm --external jsonc-parser",
    "postinstall": "node postinstall.js",
    "test": "bun test",
    "lint": "bun run --bun tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "template"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.48",
    "@types/bun": "latest",
    "@types/node": "^20.19.40"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "files": [
    "dist/v1/index.js",
    "dist/v2/index.js",
    "dist/injector.js",
    "loader.js",
    "postinstall.js",
    "README.md",
    "example-config.jsonc",
    "example-config.v2.jsonc"
  ]
}
